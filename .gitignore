*.AppImage
*.zip
*.tar.gz
# Vibemis: AppImages under testing/<task>/ are intentional artifacts that the
# Linux test agent picks up via `git pull`. The wildcard above ignores root-level
# build outputs; the unignore below opts in just the testing tree.
!testing/**/*.AppImage

# Qt Creator
*.pro.user
*.autosave

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store
*.dSYM/

# Windows
Thumbs.db
*.pdb

# Logs
*.log

# Dependencies
node_modules/

# Generated QML cache
*qmlcache*

# Config tests
config.tests/*/.qmake.stash
config.tests/*/Makefile

